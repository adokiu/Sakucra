import { IconTopButton } from "home_page.slint";

export component VersionsPage inherits Rectangle {
    callback back();

    width: 100%;
    height: 100%;
    background: #ffffff80;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            IconTopButton {
                label: "返回";
                clicked => {
                    root.back();
                }
            }
            Text {
                text: "下载";
                font-size: 15px;
                font-weight: 600;
                color: #1d1d1f;
                vertical-alignment: center;
                padding-left: 8px;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #0000000a;

            VerticalLayout {
                padding: 24px;
                spacing: 8px;
                Text {
                    text: "版本下载";
                    font-size: 17px;
                    font-weight: 600;
                    color: #1d1d1f;
                }
                Text {
                    text: "安装 Minecraft 版本与 Mod 加载器（开发中）。";
                    color: #86868b;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
